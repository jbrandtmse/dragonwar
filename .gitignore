# Parallel epic-cycle worktrees (includes .worktrees/.coordination/)
.worktrees/

# Node / build tooling (Story 1.1 scaffold)
node_modules/
dist/
.vite/

# pnpm 11 writes this as a build-approval PROMPT placeholder (literally
# "set this to true or false") whenever a dependency's build scripts are
# ignored. It is not project config, it fails check:headers, and it is
# regenerated by any local pnpm run. Ignore it; if this repo ever needs a
# real pnpm workspace file, remove this line deliberately.
pnpm-workspace.yaml

# /epic-cycle kit upgrades write timestamped backups (<file>.bak-<UTC>) beside
# every file they overwrite, so the developer can diff post-install. Keep them on
# disk for that purpose, but never in the repository -- they accumulate one set
# per upgrade and were purged by hand on 2026-08-30.
*.bak-*

# Blender writes a <name>.blend1 backup beside every .blend it saves, so any
# headless run of tools/make-placeholder-blend.py leaves one in assets/src/.
# It is a regenerable editor artifact, never project input; the committed
# .blend and the exported .glb/.collision.json are what the pipeline reads.
# Left untracked it shows up as a stray file at every commit gate.
*.blend1
