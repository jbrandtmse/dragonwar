# Deferred-work ledger is append-only across parallel epic branches
_bmad-output/implementation-artifacts/deferred-work.md merge=union

# Cycle logs are TAB-delimited and parsed field-by-field on resume; a CRLF checkout
# would append \r to every metadata value. Keep the tracker files LF in the working
# tree too, so every epic worktree parses identically.
_bmad-output/implementation-artifacts/*.md eol=lf
_bmad-output/implementation-artifacts/*.yaml eol=lf
_bmad/custom/*.yaml eol=lf

# Shell scripts must stay LF: core.autocrlf=true would otherwise give a fresh
# clone CRLF shebangs, which Git Bash rejects with "bad interpreter".
*.sh eol=lf

# Golden replay fixtures are hashed and diffed byte-for-byte across engines;
# a CRLF checkout on a fresh clone (core.autocrlf=true) would corrupt that
# comparison. Every downstream reader already normalises line endings as a
# workaround -- this makes the LF guarantee structural instead.
test/replays/** eol=lf
_bmad-output/planning-artifacts/architecture/**/.memlog.md merge=union
