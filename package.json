{
  "name": "dragonwar",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.sim.json && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "check:dist": "node tools/check-dist.mjs",
    "check:size": "node tools/size-budget.mjs",
    "lint:boundaries": "node tools/boundary-lint.mjs",
    "check:headers": "node tools/check-licence-headers.mjs",
    "check:attributions": "node tools/check-attributions.mjs",
    "export:assets": "node tools/export-assets.mjs",
    "check:ad7": "vitest run --config test/fixtures/dw70-ad7/vitest.harness.config.ts",
    "check:corridor": "vitest run --config test/fixtures/dw137-corridor/vitest.harness.config.ts"
  },
  "devDependencies": {
    "@swc/core": "1.16.1",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@babylonjs/core": "9.22.2",
    "@babylonjs/loaders": "9.22.2"
  }
}
